{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "townpass-nadedao",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  // public/ 是微服務網頁（比對在手機上完成）；/api/* 交給 Worker
  "assets": {
    "directory": "./public/",
    "run_worker_first": ["/api/*"]
  },
  // 代理授權同步（兩支手機之間）：只存授權狀態與代辦紀錄
  "d1_databases": [
    { "binding": "DB", "database_name": "nadedao-proxy", "database_id": "56ee4533-40f3-47f1-9672-8096efa8e37e", "migrations_dir": "migrations" }
  ],
  "observability": { "enabled": true }
}
